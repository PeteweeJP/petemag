# Files git should never upload to GitHub.
# Note: ignoring a file that's already committed does not remove it from GitHub.
# That also needs `git rm --cached <file>`.

# Dependencies and build output (recreated by npm install / npm run build)
node_modules/
dist/
.astro/

# Secrets and local settings
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
logs/

# OS and editor clutter
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Planning docs: kept on Pete's Mac only, not published to GitHub (decided 2026-09-26).
# They still exist locally and Claude still reads them; they're just not backed up by git.
docs/reference/
docs/design/
docs/decisions.md
docs/brand-voice.md
docs/seo.md
