# Cloudflare response headers (ignored by other hosts). The Content Security Policy itself is a
# <meta> tag on every page (astro.config.mjs); these add the protections a meta tag can't.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Fingerprinted build files and fonts never change under the same name: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
