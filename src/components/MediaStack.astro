---
// Right column of a case study. Missing images/videos render as labeled placeholders.
// Images with `zoom: true` open full size in a lightbox when clicked.
import { url } from '../lib/url';
import { hasAsset, imageDims } from '../lib/content';
import type { Entry } from '../lib/content';

interface Props {
  items: Entry['data']['media'];
}

const { items } = Astro.props;
const hasZoom = items.some((item) => item.zoom && hasAsset(item.src));

// Vimeo player URL. Always: no tracking cookies, and no title/byline/avatar overlays.
// Looping videos also get loop + muted; autoplay is added by the script below unless the
// visitor prefers reduced motion (so no-JavaScript and reduced-motion visitors get click-to-play).
const vimeoSrc = (id: string, loop: boolean, autoplay = false) => {
  const params = new URLSearchParams({ dnt: '1', title: '0', byline: '0', portrait: '0' });
  if (loop) {
    params.set('loop', '1');
    params.set('muted', '1');
    params.set('autopause', '0');
    params.set('playsinline', '1');
  }
  if (autoplay) params.set('autoplay', '1');
  return `https://player.vimeo.com/video/${id}?${params}`;
};
---
<div class="media-stack">
  {items.map((item) => {
    // Small eyebrow-style label above each item: `caption`, or else the description (alt). caption: "" = no label.
    // When the label repeats the description, screen readers skip the label so they don't hear it twice.
    const caption = item.caption ?? item.alt;
    const repeatsAlt = caption === item.alt;
    let media;
    if (item.type === 'video') {
      media = item.vimeo ? (
        <div class="media-video">
          <iframe
            src={vimeoSrc(item.vimeo, item.loop)}
            data-autoplay-src={item.loop ? vimeoSrc(item.vimeo, true, true) : undefined}
            title={item.alt}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="autoplay; fullscreen; picture-in-picture"
          />
        </div>
      ) : (
        <div class="media-placeholder">Video: {item.alt}<br /><small>add a Vimeo ID</small></div>
      );
    } else if (item.type === 'loop' && hasAsset(item.src)) {
      // GIF-style loop: silent, repeating, no player chrome, with a pause/play button (WCAG 2.2.2).
      // The script below starts it unless the visitor prefers reduced motion, and pauses it off screen.
      media = (
        <div class="media-loop">
          <video
            muted
            loop
            playsinline
            preload="metadata"
            poster={hasAsset(item.poster) ? url(item.poster) : undefined}
            aria-label={item.alt}
            {...imageDims(item.poster ?? item.src)}
            data-loop
          >
            {hasAsset(item.webm) && <source src={url(item.webm)} type="video/webm" />}
            <source src={url(item.src)} type="video/mp4" />
          </video>
          <button class="video-toggle" type="button" aria-label={`Play: ${item.caption ?? item.alt}`} data-loop-toggle hidden>
            <svg class="video-toggle__pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
            <svg class="video-toggle__play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
          </button>
        </div>
      );
    } else if (!hasAsset(item.src)) {
      media = <div class="media-placeholder">{item.alt}<br /><small>{item.src ?? 'no file set'}</small></div>;
    } else {
      const img = <img src={url(item.src)} alt={item.alt} {...imageDims(item.src)} loading="lazy" decoding="async" />;
      media = item.zoom ? (
        <button class="zoomable" type="button" aria-label={`Enlarge image: ${item.alt}`}>{img}</button>
      ) : img;
    }
    return (
      <figure class:list={['media-item', { 'media-item--actual': item.actualSize }]}>
        {caption !== '' && (
          <figcaption class="media-caption" aria-hidden={repeatsAlt ? 'true' : undefined}>{caption}</figcaption>
        )}
        {media}
      </figure>
    );
  })}
</div>

{hasZoom && (
  <dialog class="lightbox" aria-label="Enlarged image">
    <form method="dialog"><button class="lightbox__close" aria-label="Close">×</button></form>
  </dialog>
)}

<script>
  // GIF-style loops: play while on screen (unless reduced motion or the visitor paused it); pause button.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.media-loop').forEach((box) => {
    const video = box.querySelector<HTMLVideoElement>('video[data-loop]');
    const toggle = box.querySelector<HTMLButtonElement>('[data-loop-toggle]');
    if (!video || !toggle) return;
    const name = (toggle.getAttribute('aria-label') ?? '').replace(/^Play: /, '');
    let userPaused = reduceMotion; // reduced motion: start paused; the visitor can press play
    const show = (playing: boolean) => {
      toggle.dataset.state = playing ? 'playing' : 'paused';
      toggle.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'}: ${name}`);
    };
    video.addEventListener('play', () => show(true));
    video.addEventListener('pause', () => show(false));
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (video.paused) video.play().catch(() => show(false));
      else video.pause();
    });
    // Only run while visible: saves battery and bandwidth on long pages.
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !userPaused) video.play().catch(() => show(false));
      else if (!entry.isIntersecting) video.pause();
    }, { threshold: 0.25 }).observe(video);
    toggle.hidden = false;
    show(false);
  });

  // Looping Vimeo videos start playing on their own, unless the visitor prefers reduced motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLIFrameElement>('iframe[data-autoplay-src]').forEach((frame) => {
      frame.src = frame.dataset.autoplaySrc!;
    });
  }

  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  if (dialog) {
    const full = document.createElement('img');
    dialog.append(full);
    document.querySelectorAll<HTMLButtonElement>('.zoomable').forEach((button) => {
      button.addEventListener('click', () => {
        const img = button.querySelector('img');
        if (!img) return;
        full.src = img.src;
        full.alt = img.alt;
        dialog.showModal();
        dialog.scrollTop = 0;
      });
    });
    // Clicking the dark backdrop closes it (Escape and the × button already do).
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
