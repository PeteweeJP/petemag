---
// One image tile in a section grid. Hover/focus reveals the detail page title.
// The background is a real lazy-loaded <img> (not CSS), so a grid of 25 tiles doesn't
// download every photo up front.
import { url } from '../lib/url';
import { hasAsset } from '../lib/content';
import type { Entry } from '../lib/content';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { title, client, tile } = entry.data;
---
<a class="tile" href={url(entry.id)} aria-label={`${title} (${client})`}>
  {hasAsset(tile.image) && <img class="tile__bg" src={url(tile.image)} alt="" loading="lazy" decoding="async" />}
  <span class="tile__face">
    {hasAsset(tile.logo)
      ? <img class="tile__logo" src={url(tile.logo)} alt={tile.label} loading="lazy" decoding="async" />
      : <span class="tile__label">{tile.label}</span>}
    {tile.subtitle && <span class="tile__subtitle">{tile.subtitle}</span>}
  </span>
  <span class="tile__hover" aria-hidden="true">
    <span class="tile__title">{title}</span>
    <span class="tile__view">— view —</span>
  </span>
</a>
