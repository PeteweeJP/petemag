---
// Original Squarespace home: portrait photo left, name/role/tagline/nav right.
// Kept as a fallback while the new home is designed. Select it in src/data/site.ts (home: 'split').
import { site } from '../../data/site';
import { url } from '../../lib/url';
import { hasAsset } from '../../lib/content';

const portrait = 'images/home/portrait.jpg';
---
<section class="home">
  <div class="home__photo">
    {hasAsset(portrait) && <img src={url(portrait)} alt="Portrait of Peter Magulak" />}
  </div>
  <div class="home__intro">
    <h1 class="home__name">{site.name}</h1>
    <p class="home__role">{site.role}</p>
    <p class="home__tagline">{site.tagline}</p>
    <nav aria-label="Main" class="home__nav">
      {site.nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
    </nav>
  </div>
</section>
