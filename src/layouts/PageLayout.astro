---
// Wrapper for markdown pages in src/pages (e.g. resume.md). Frontmatter: title, description, section.
import BaseLayout from './BaseLayout.astro';

const { title, description, section } = Astro.props.frontmatter;
---
<BaseLayout title={title} description={description} section={section}>
  <article class="prose-page">
    <slot />
  </article>
</BaseLayout>
