---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

// The form posts to Web3Forms (GitHub Pages can't process forms). It only appears once
// site.contactForm.accessKey is set; until then the page shows email + LinkedIn only.
const { accessKey, hcaptchaSiteKey } = site.contactForm;
const formReady = Boolean(accessKey);
const thanksUrl = new URL(url('thanks'), Astro.site).href; // no-JavaScript fallback after sending
---
<BaseLayout title="Contact" section="contact" description="Get in touch with Peter Magulak about freelance work, jobs or general questions.">
  <section class="split-page">
    <h1>Contact</h1>
    <div>
      <!-- TODO: paste the exact playful intro from the current Contact page (this is a paraphrase). -->
      <p>
        Want to compliment my beard-growing skills? Have a freelance project, a job opening, or just a
        question? Drop me a line and I'll get back to you.
      </p>

      {!formReady && import.meta.env.DEV && (
        <p class="form-note">Preview only: the form appears once the Web3Forms access key is added to <code>src/data/site.ts</code>.</p>
      )}

      {(formReady || import.meta.env.DEV) && (
        <form class="contact-form" action="https://api.web3forms.com/submit" method="POST" data-contact-form>
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="subject" value="New message from petemag.com" />
          <input type="hidden" name="from_name" value="petemag.com contact form" />
          <input type="hidden" name="redirect" value={thanksUrl} />
          {/* Honeypot: hidden from people; bots that fill it in are rejected */}
          <input type="checkbox" name="botcheck" class="contact-form__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="field">
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" />
          </div>
          <div class="field">
            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200" />
          </div>
          <div class="field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="6" required maxlength="5000"></textarea>
          </div>

          <div class="h-captcha" data-sitekey={hcaptchaSiteKey}></div>

          <button class="button" type="submit">Send message</button>
          <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        </form>
      )}

      <p class="contact-alt">
        Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a> ·
        <a href={site.linkedin} rel="me noopener noreferrer">LinkedIn</a>
      </p>
    </div>
  </section>
</BaseLayout>

{(formReady || import.meta.env.DEV) && <script is:inline src="https://js.hcaptcha.com/1/api.js" async defer></script>}

<script>
  // Sends the form in the background and shows the result in place. Without JavaScript the
  // form still posts normally and Web3Forms redirects to /thanks.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  type HCaptcha = { reset: () => void };

  if (form && status) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const say = (text: string, tone: 'info' | 'error' | 'success') => {
      status.textContent = text;
      status.dataset.tone = tone;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (!data.get('access_key')) {
        say('This form isn’t connected yet. Please email me instead.', 'error');
        return;
      }
      if (!data.get('h-captcha-response')) {
        say('Please complete the captcha, then send again.', 'error');
        return;
      }
      if (button) button.disabled = true;
      say('Sending…', 'info');
      try {
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          form.reset();
          say('Thanks! Your message is on its way. I’ll get back to you soon.', 'success');
        } else {
          throw new Error(json?.body?.message || json?.message || 'Send failed');
        }
      } catch {
        say('Sorry, that didn’t send. Please try again, or email me directly.', 'error');
      } finally {
        (window as Window & { hcaptcha?: HCaptcha }).hcaptcha?.reset();
        if (button) button.disabled = false;
      }
    });
  }
</script>
