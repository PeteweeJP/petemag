---
import BaseLayout from '../layouts/BaseLayout.astro';
import TileGrid from '../components/TileGrid.astro';
import { getSection } from '../lib/content';

const entries = await getSection('illustration');
---
<BaseLayout title="Illustration" section="illustration">
  <h1 class="visually-hidden">Illustration</h1>
  <TileGrid entries={entries} />
</BaseLayout>
