// Cloudflare hosting: the built site (dist/) is served as static files by a Worker with no code
// (Cloudflare's current replacement for Pages). Deploy with `npm run deploy` after `npm run build`.
// Address: https://petemag.petemag.workers.dev (until petemag.com is pointed here).
{
  "name": "petemag",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    // Unknown addresses get dist/404.html with a real 404 status.
    "not_found_handling": "404-page",
    // /paradise serves paradise.html; /paradise/ forwards to /paradise.
    "html_handling": "auto-trailing-slash"
  }
}
